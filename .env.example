# Supabase (public/anon key for client-side fetching)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOTS={"grid":"slot1","footer":"slot2"}

# Supabase service role (server-side only, for fetch-model-responses.ts)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider API Keys (for fetch-model-responses.ts)
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
